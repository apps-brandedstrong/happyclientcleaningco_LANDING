# === Resend (envío de los formularios) ===
# 1. Crear cuenta en https://resend.com
# 2. API Keys → Create API Key → copiar acá
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Remitente. Para producción hay que verificar el dominio en Resend
# (Domains → Add Domain → cargar los DNS) y usar algo así:
# RESEND_FROM="Happy Client Cleaning <leads@happyclientcleaningco.com>"
#
# Sin dominio verificado, Resend solo permite onboarding@resend.dev y
# SOLO entrega al email dueño de la cuenta de Resend.
RESEND_FROM="Happy Client Landing <onboarding@resend.dev>"

# Destinatarios de cada lead, separados por coma.
# Si no se define, usa los tres por defecto que están en api/send-email.ts
LEAD_RECIPIENTS=happyclientcleaning@gmail.com,info@happyclientcleaningco.com,dalila@latinbranding.com
